# Public template — copy to .env.local and fill in.
# Real values per integration are added when the corresponding sprint starts.

# Local ports
WEB_PORT=3000
API_PORT=3001

# Supabase (Sprint 1+) — values come from `supabase status` after `supabase start`.
# Local dev defaults shown; hosted project values differ.
#
# URL and ANON_KEY use the NEXT_PUBLIC_ prefix so the same .env.local is shared
# with the Next.js frontend. The anon key is intended to be public per Supabase's
# security model (RLS enforces tenant boundaries). Server-side code in
# packages/db accepts both prefixed and unprefixed names — see packages/db/src/env.ts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (Sprint 3+) — BullMQ workers + queues. Upstash free tier supports
# rediss:// (TLS) and persistent connections required by BullMQ.
REDIS_URL=

# Anthropic (Sprint 3+) — single master key from the Claude Teams workspace.
# Per-org keys deferred to Phase 2 enterprise tier.
ANTHROPIC_API_KEY=

# Agent runtime tuning (optional — sensible defaults baked in)
AGENT_DEFAULT_MAX_TOKENS=4096
WORKER_CONCURRENCY=4

# Slack concierge bot (Sprint 7c) — OAuth-installed DM bot.
# Create the app at api.slack.com/apps; copy Client ID/Secret + Signing Secret.
# All paths are mock-default (SLACK_LIVE unset/false): the bot never calls real
# Slack and OAuth/token storage use in-process mocks. Set SLACK_LIVE=true only
# once ngrok + Event Subscriptions are wired (Sprint 8+).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Separate from SLACK_SIGNING_SECRET in production; falls back to it in dev.
# Signs the OAuth `state` param (CSRF guard for /api/slack/oauth/callback).
SLACK_STATE_SECRET=
# Set 'true' to hit the real Slack API; default (unset) = mock everything.
SLACK_LIVE=
# Must match the Redirect URL registered in the Slack app OAuth settings.
# Default (unset): http://localhost:${API_PORT}/api/slack/oauth/callback
SLACK_OAUTH_REDIRECT_URI=
