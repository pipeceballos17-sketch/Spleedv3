{
  "name": "@spleed/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist *.tsbuildinfo",
    "db:generate": "bun --env-file=../../.env.local x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local src/scripts/migrate.ts",
    "db:reset": "bun --env-file=../../.env.local src/scripts/reset.ts",
    "db:seed": "bun --env-file=../../.env.local src/seed/index.ts",
    "test": "bun --env-file=../../.env.local test src/tests/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
